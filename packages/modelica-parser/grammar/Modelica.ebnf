// Modelica 3.7 Appendix A syntax subset (pinned annex
// build/modelica-3.7-syntax-reference.html; see README.md for the clause table).
// Every production keeps its Appendix A name. A production either keeps its
// annex sequence or omits whole alternatives; README.md lists the optional
// parts not yet present and the two left-factored productions, whose word
// languages equal the annex forms (ModelicaParser/Annex.lean). Numbers are
// `IDENT`-symbol number tokens. Admission is static semantics after parsing:
// which classes, declarations, equations, operators and callees are accepted
// is decided by core selection over the parsed AST, not by this grammar.
// The first production is the start symbol.

stored_definition = { class_definition, ";" };
class_definition = class_prefixes, class_specifier;
class_prefixes = "model";
class_specifier = long_class_specifier;
long_class_specifier = IDENT, composition, "end", IDENT;
composition = element_list, { equation_section };
element_list = { element, ";" };
element = component_clause;

component_clause = type_prefix, type_specifier, [ array_subscripts ], component_list;
type_prefix = [ "input" | "output" ];
type_specifier = name;
component_list = component_declaration, { ",", component_declaration };
component_declaration = declaration;
declaration = IDENT, [ array_subscripts ], [ modification ];

modification = class_modification, [ "=", modification_expression ]
    | "=", modification_expression;
modification_expression = expression;
class_modification = "(", [ argument_list ], ")";
argument_list = argument, { ",", argument };
argument = element_modification_or_replaceable;
element_modification_or_replaceable = [ "each" ], element_modification;
element_modification = name, [ modification ];

equation_section = "equation", { some_equation, ";" };
some_equation = equation_or_procedure;
equation_or_procedure = simple_equation;
simple_equation = simple_expression, "=", expression;

expression = simple_expression;
simple_expression = logical_expression;
logical_expression = logical_term;
logical_term = logical_factor;
logical_factor = relation;
relation = arithmetic_expression;
arithmetic_expression = term, { add_operator, term }
    | add_operator, term, { add_operator, term };
add_operator = "+" | "-";
term = factor, { mul_operator, factor };
mul_operator = "*" | "/" | ".*";
factor = primary;
primary = component_reference
    | ( component_reference | "der" ), function_call_args
    | "false" | "true"
    | "(", output_expression_list, ")";

name = IDENT, { ".", IDENT };
component_reference = IDENT, [ array_subscripts ], { ".", IDENT, [ array_subscripts ] }
    | ".", IDENT, [ array_subscripts ], { ".", IDENT, [ array_subscripts ] };
function_call_args = "(", [ function_arguments ], ")";
function_arguments = expression, [ ",", function_arguments_non_first ];
function_arguments_non_first = function_argument, [ ",", function_arguments_non_first ];
function_argument = expression;
output_expression_list = [ expression ], { ",", [ expression ] };
array_subscripts = "[", subscript, { ",", subscript }, "]";
subscript = expression;
